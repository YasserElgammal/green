APP_DEBUG=true
# local || production
APP_ENV=local
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_LANG_PATH=lang
APP_TRANSLATION_CACHE_PATH=storage/cache/translations

# Database
DB_DRIVER=pdo_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=green_framework
DB_USER=root
DB_PASSWORD=

# SMTP
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# LOG System
# Log files directory (default: storage/logs)
LOG_DIR=storage/logs

# Minimum log level (default: debug)
# Available values: debug, info, warning, error, critical
LOG_LEVEL=warning

# Number of times the same error can be repeated in a single request (default: 5, 0 = unlimited)
LOG_MAX_DUPLICATES=5

# Maximum number of times the same error can be logged within a time window (default: 50)
LOG_RATE_LIMIT=50

# Time window duration in seconds (default: 60)
LOG_RATE_WINDOW=60

# JWT Auth
JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=604800
