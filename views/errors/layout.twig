{% set code = code|default(status_code|default(500)) %}
{% set title = title|default('Server Error') %}
{% set message = message|default('Something went wrong while processing your request.') %}
{% set home_url = home_url|default('/') %}
{% set show_home_button = show_home_button|default(true) %}
{% set show_back_button = show_back_button|default(true) %}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{{ code }} - {{ title }}</title>
    <script src="/assets/js/theme-init.js"></script>
    <style>
        :root {
            --page-bg: #f7f8fb;
            --card-bg: #ffffff;
            --text: #111827;
            --muted: #64748b;
            --border: #e5e7eb;
            --accent: #047857;
            --accent-strong: #065f46;
            --shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
            --button-bg: #ffffff;
            --button-hover-border: #cbd5e1;
            color-scheme: light;
        }

        html[data-theme="dark"] {
            --page-bg: #0f172a;
            --card-bg: #111827;
            --text: #f8fafc;
            --muted: #94a3b8;
            --border: rgba(148, 163, 184, 0.22);
            --accent: #047857;
            --accent-strong: #065f46;
            --shadow: 0 28px 80px rgba(0, 0, 0, 0.52);
            --button-bg: #0f172a;
            --button-hover-border: rgba(148, 163, 184, 0.36);
            color-scheme: dark;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(4, 120, 87, 0.10), transparent 32rem),
                var(--page-bg);
            color: var(--text);
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            display: grid;
            place-items: center;
            padding: 2rem;
        }

        .error-card {
            width: min(100%, 34rem);
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: clamp(2rem, 5vw, 3rem);
            text-align: center;
        }

        .error-code {
            width: fit-content;
            margin: 0 auto 1.25rem;
            border: 1px solid rgba(4, 120, 87, 0.18);
            border-radius: 999px;
            color: var(--accent-strong);
            background: rgba(4, 120, 87, 0.08);
            font-size: 0.875rem;
            font-weight: 700;
            line-height: 1;
            padding: 0.625rem 0.875rem;
        }

        h1 {
            margin: 0;
            font-size: clamp(1.875rem, 5vw, 2.5rem);
            line-height: 1.1;
            font-weight: 750;
            letter-spacing: 0;
        }

        .message {
            margin: 1rem auto 0;
            max-width: 28rem;
            color: var(--muted);
            font-size: 1rem;
            line-height: 1.65;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem;
            margin-top: 2rem;
        }

        .button {
            border: 1px solid var(--border);
            border-radius: 6px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2.75rem;
            padding: 0.75rem 1rem;
            color: var(--text);
            background: var(--button-bg);
            font: inherit;
            font-weight: 650;
            text-decoration: none;
            transition: background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
        }

        .button:hover {
            border-color: var(--button-hover-border);
            transform: translateY(-1px);
        }

        .button-primary {
            border-color: var(--accent);
            background: var(--accent);
            color: #ffffff;
        }

        .button-primary:hover {
            border-color: var(--accent-strong);
            background: var(--accent-strong);
        }

        @media (max-width: 420px) {
            body {
                padding: 1rem;
            }

            .actions {
                flex-direction: column;
            }

            .button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <main class="error-card" aria-labelledby="error-title">
        <div class="error-code">Error {{ code }}</div>
        <h1 id="error-title">{{ title }}</h1>
        <p class="message">{{ message }}</p>

        {% if show_home_button or show_back_button %}
            <div class="actions">
                {% if show_home_button %}
                    <a class="button button-primary" href="{{ home_url }}">Back to home</a>
                {% endif %}

                {% if show_back_button %}
                    <button class="button" type="button" onclick="history.back()">Go back</button>
                {% endif %}
            </div>
        {% endif %}
    </main>
</body>
</html>
