{% set app_locale = session().get('locale') ?? 'en' %}
{% set app_dir = app_locale == 'ar' ? 'rtl' : 'ltr' %}
<!DOCTYPE html>
<html lang="{{ app_locale }}" dir="{{ app_dir }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Green Blog{% endblock %}</title>

    <!-- Google Fonts: Inter (English) & Cairo (Arabic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    {% if app_dir == 'rtl' %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    {% else %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% endif %}
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --green-primary: #10b981;
            --green-dark: #047857;
            --green-light: #d1fae5;
            --bg-color: #f3f4f6;
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.4);
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }

        body {
            font-family: {% if app_dir == 'rtl' %}'Cairo', sans-serif{% else %}'Inter', sans-serif{% endif %};
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 50%, #d1fae5 100%);
            background-attachment: fixed;
        }

        /* Glassmorphism Header */
        header {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--glass-border);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--green-dark) !important;
            letter-spacing: -0.5px;
            font-size: 1.5rem;
        }

        .nav-link-custom {
            color: var(--text-main);
            font-weight: 500;
            transition: color 0.2s ease;
        }
        .nav-link-custom:hover {
            color: var(--green-primary);
        }

        .btn-green {
            background-color: var(--green-primary);
            color: white;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.2);
        }
        .btn-green:hover {
            background-color: var(--green-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 8px -1px rgba(16, 185, 129, 0.3);
            color: white;
        }

        .btn-green-outline {
            color: var(--green-dark);
            border: 2px solid var(--green-primary);
            font-weight: 600;
            transition: all 0.3s ease;
            background: transparent;
        }
        .btn-green-outline:hover {
            background: var(--green-primary);
            color: white;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 1rem;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .glass-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }

        main {
            flex: 1;
        }

        footer {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            border-top: 1px solid var(--glass-border);
        }

        /* Custom Premium Inputs */
        .form-control-custom {
            background: rgba(255, 255, 255, 0.5) !important;
            border: 1px solid rgba(16, 185, 129, 0.2) !important;
            border-radius: 0.75rem !important;
            padding: 0.75rem 1rem !important;
            color: var(--text-main) !important;
            transition: all 0.3s ease !important;
        }
        .form-control-custom:focus {
            background: rgba(255, 255, 255, 0.9) !important;
            border-color: var(--green-primary) !important;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15) !important;
            outline: 0 !important;
        }
        
        .form-label-custom {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            display: inline-block;
        }

        .auth-icon-container {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--green-light) 0%, rgba(16, 185, 129, 0.2) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem auto;
            color: var(--green-dark);
            font-size: 1.5rem;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.1);
        }
    </style>
</head>
<body>

    <!-- Glassy Header -->
    <header class="py-3">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/" class="text-decoration-none navbar-brand">
                <i class="bi bi-leaf-fill me-1 text-success"></i>Green
            </a>
            <nav class="d-flex align-items-center">
                <a href="/posts" class="text-decoration-none me-4 nav-link-custom">{{ t('layout.posts') }}</a>
                
                <div class="dropdown me-4">
                    <button class="btn btn-sm btn-green-outline dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-globe me-1"></i> {{ app_locale | upper }}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                        <li><a class="dropdown-item {% if app_locale == 'en' %}active{% endif %}" href="/lang/en">English</a></li>
                        <li><a class="dropdown-item {% if app_locale == 'ar' %}active{% endif %}" href="/lang/ar">العربية</a></li>
                    </ul>
                </div>

                {% if session().has('user_id') %}
                    <span class="text-muted me-3 small fw-medium">{{ t('layout.hello', {'name': session().get('user_name')}) }}</span>
                    <form action="/logout" method="POST" class="d-inline">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-sm btn-green-outline rounded-pill px-3">{{ t('layout.logout') }}</button>
                    </form>
                {% else %}
                    <a href="/login" class="text-decoration-none me-3 nav-link-custom">{{ t('layout.login') }}</a>
                    <a href="/register" class="btn btn-sm btn-green rounded-pill px-4">{{ t('layout.register') }}</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <!-- Content -->
    <main class="container my-5">
        {% set success = session().getFlash('success') %}
        {% if success %}
            <!-- Toast Notification -->
            <div class="position-fixed end-0 p-3" style="z-index: 1100; max-width: 400px; width: 100%; top: 80px;">
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> {{ success[0] }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        {% endif %}

        {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="py-4 mt-auto">
        <div class="container text-center text-muted small fw-medium">
            © {{ "now"|date("Y") }} {{ t('layout.rights_reserved') }}
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
