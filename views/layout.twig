<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}
			{% endblock %}
		</title>

		<!-- Bootstrap CSS -->
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	</head>
	<body
		class="bg-light">

		<!-- Header -->
		<header class="py-3 shadow-sm" style="background-color: #166534; color: white;">
			<div class="container d-flex justify-content-between align-items-center">
				<h1 class="h4 mb-0"><a href="/" class="text-white text-decoration-none">Green</a></h1>
                <nav>
                    <a href="/posts" class="text-white text-decoration-none me-3">Posts</a>
                    {% if session().has('user_id') %}
                        <span class="text-light me-3 small">Hello, {{ session().get('user_name') }}</span>
                        <form action="/logout" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light border-0">Logout</button>
                        </form>
                    {% else %}
                        <a href="/login" class="text-white text-decoration-none me-3">Login</a>
                        <a href="/register" class="btn btn-sm btn-light text-success fw-bold">Register</a>
                    {% endif %}
                </nav>
			</div>
		</header>

		<!-- Content -->
		<main class="container my-4">
            
            {% set success = session().getFlash('success') %}
            {% if success %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ success[0] }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endif %}

			<div class="card shadow-sm border-0">
				<div class="card-body"> {% block content %}{% endblock %}
					</div>
				</div>
			</main>

			<!-- Footer -->
			<footer class="bg-white border-top py-3 mt-auto">
				<div class="container text-center text-muted small">
					©
					{{ "now"|date("Y") }}
					Green. All rights reserved.
				</div>
			</footer>

			<!-- Bootstrap JS -->
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

		</body>
	</html>
