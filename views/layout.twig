{% set app_locale = session().get('locale') ?? 'en' %}
{% set app_dir = app_locale == 'ar' ? 'rtl' : 'ltr' %}
<!DOCTYPE html>
<html lang="{{ app_locale }}" dir="{{ app_dir }}" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Green Framework{% endblock %}</title>
    <script src="/assets/js/theme-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    {% if app_dir == 'rtl' %}<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">{% else %}<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">{% endif %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/theme.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="py-3 navbar navbar-expand-lg">
        <div class="container">
            <a href="{{ route('home') }}" class="text-decoration-none navbar-brand">
                <i class="bi bi-leaf-fill me-1 text-success"></i>Green
            </a>
            <button class="navbar-toggler btn-green-outline rounded-3" type="button" data-bs-toggle="collapse" data-bs-target="#greenNavbar" aria-controls="greenNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>
            <div class="collapse navbar-collapse flex-lg-grow-0" id="greenNavbar">
                <nav class="navbar-menu d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center ms-lg-auto mt-3 mt-lg-0">
                    <a href="{{ route('home') }}" class="text-decoration-none me-lg-4 mb-2 mb-lg-0 nav-link-custom {% if current_route() == '/' %}active{% endif %}">{{ t('layout.home') }}</a>
                    <div class="dropdown me-lg-4 mb-2 mb-lg-0">
                        <button class="btn btn-sm btn-green-outline dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown"><i class="bi bi-globe me-1"></i>{{ app_locale|upper }}</button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li><a class="dropdown-item {% if app_locale == 'en' %}active{% endif %}" href="{{ route('locale.switch', {locale: 'en'}) }}">English</a></li>
                            <li><a class="dropdown-item {% if app_locale == 'ar' %}active{% endif %}" href="{{ route('locale.switch', {locale: 'ar'}) }}">العربية</a></li>
                        </ul>
                    </div>
                    <div class="dropdown theme-toggle me-lg-4 mb-2 mb-lg-0">
                        <button class="btn btn-sm btn-green-outline dropdown-toggle rounded-pill px-3" type="button" id="themeToggle" data-theme-toggle data-theme-label-light="{{ t('layout.theme.light') }}" data-theme-label-dark="{{ t('layout.theme.dark') }}" data-theme-label-system="{{ t('layout.theme.system') }}" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ t('layout.theme.toggle') }}">
                            <i class="bi bi-circle-half theme-toggle-icon" data-theme-toggle-icon aria-hidden="true"></i>
                            <span class="visually-hidden" data-theme-toggle-label>System</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm p-2" aria-labelledby="themeToggle">
                            <li><button class="dropdown-item" type="button" data-theme-choice="light"><i class="bi bi-sun"></i><span>{{ t('layout.theme.light') }}</span></button></li>
                            <li><button class="dropdown-item" type="button" data-theme-choice="dark"><i class="bi bi-moon-stars"></i><span>{{ t('layout.theme.dark') }}</span></button></li>
                            <li><button class="dropdown-item" type="button" data-theme-choice="system"><i class="bi bi-laptop"></i><span>{{ t('layout.theme.system') }}</span></button></li>
                        </ul>
                    </div>
                    {% if session().has('user_id') %}
                        <div class="d-flex align-items-center me-lg-3 mb-2 mb-lg-0">
                            <a href="{{ route('profile.show') }}" class="me-2"><i class="bi bi-person-circle text-muted" style="font-size:1.5rem;"></i></a>
                            <a href="{{ route('profile.show') }}" class="text-muted small fw-medium text-decoration-none">{{ t('layout.hello', {'name': session().get('user_name')}) }}</a>
                        </div>
                        <form action="{{ route('logout') }}" method="POST" class="d-inline">
                            {{ csrf_field() }}
                            <button type="submit" class="btn btn-sm btn-green-outline rounded-pill px-3">{{ t('layout.logout') }}</button>
                        </form>
                    {% else %}
                        <a href="{{ route('login.form') }}" class="btn btn-sm btn-green rounded-pill px-4">{{ t('layout.login') }}</a>
                    {% endif %}
                </nav>
            </div>
        </div>
    </header>

    {% set success = session().getFlash('success') %}
    {% set error = session().getFlash('error') %}
    {% if success or error %}
        <div class="flash-toast-layer" aria-live="polite" aria-atomic="true">
            {% if success %}<div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-4" role="alert"><i class="bi bi-check-circle-fill me-2"></i>{{ success[0] }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>{% endif %}
            {% if error %}<div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-4" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>{{ error[0] }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>{% endif %}
        </div>
    {% endif %}

    <main class="container my-5" id="main-content" tabindex="-1">{% block content %}{% endblock %}</main>
    <footer class="py-4 mt-auto"><div class="container text-center text-muted small fw-medium">© {{ "now"|date("Y") }} {{ t('layout.rights_reserved') }}</div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/theme-toggle.js"></script>
    <script src="/assets/js/flash-messages.js"></script>
</body>
</html>
