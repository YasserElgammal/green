{% extends 'admin/layout.twig' %}

{% set admin_section = 'statistics' %}

{% block title %}{{ t('admin.statistics') }}{% endblock %}
{% block breadcrumb %}{{ t('admin.statistics') }}{% endblock %}
{% block page_title %}{{ t('admin.statistics') }}{% endblock %}

{% block content %}
    <section class="admin-page-header">
        <div>
            <p class="admin-eyebrow">{{ t('admin.application_intelligence') }}</p>
            <h2>{{ t('admin.statistics_heading') }}</h2>
            <p>{{ t('admin.statistics_intro') }}</p>
        </div>
    </section>

    {% include 'admin/partials/stats.twig' with {'stats': stats} %}

    <section class="admin-stat-sections">
        <article class="admin-panel">
            <div class="admin-panel-header"><div><h3>{{ t('admin.user_statistics') }}</h3><p>{{ t('admin.registration_coverage') }}</p></div></div>
            <div class="admin-metric-list">
                <div><span>{{ t('admin.total_users') }}</span><strong>{{ stats.users }}</strong></div>
                <div><span>{{ t('admin.total_admins') }}</span><strong>{{ stats.admins }}</strong></div>
                <div><span>{{ t('admin.new_users_month') }}</span><strong>{{ stats.new_users_month }}</strong></div>
            </div>
        </article>
        <article class="admin-panel">
            <div class="admin-panel-header"><div><h3>{{ t('admin.post_statistics') }}</h3><p>{{ t('admin.publishing_volume') }}</p></div></div>
            <div class="admin-metric-list">
                <div><span>{{ t('admin.total_posts') }}</span><strong>{{ stats.posts }}</strong></div>
                <div><span>{{ t('admin.posts_month') }}</span><strong>{{ stats.posts_month }}</strong></div>
            </div>
        </article>
        <article class="admin-panel">
            <div class="admin-panel-header"><div><h3>{{ t('admin.comment_statistics') }}</h3><p>{{ t('admin.conversation_volume') }}</p></div></div>
            <div class="admin-metric-list">
                <div><span>{{ t('admin.total_comments') }}</span><strong>{{ stats.comments }}</strong></div>
                <div><span>{{ t('admin.comments_month') }}</span><strong>{{ stats.comments_month }}</strong></div>
            </div>
        </article>
    </section>

    <h3 class="admin-section-heading">{{ t('admin.recent_activity') }}</h3>
    <section class="admin-dashboard-lists">
        {% include 'admin/partials/activity-list.twig' with {'title': t('admin.latest_registrations'), 'items': latestUsers, 'type': 'users'} %}
        {% include 'admin/partials/activity-list.twig' with {'title': t('admin.latest_posts'), 'items': latestPosts, 'type': 'posts'} %}
        {% include 'admin/partials/activity-list.twig' with {'title': t('admin.latest_comments'), 'items': latestComments, 'type': 'comments'} %}
    </section>
{% endblock %}
