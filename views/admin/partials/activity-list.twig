<article class="admin-panel">
    <div class="admin-panel-header">
        <div>
            <h3>{{ title }}</h3>
            <p>{{ t('admin.activity_help') }}</p>
        </div>
    </div>
    <div class="admin-list">
        {% for item in items %}
            <div class="admin-list-item">
                <span class="admin-avatar admin-avatar-sm">{{ (item.name|default(item.author.name|default(item.title|default('G'))))|first|upper }}</span>
                <div>
                    {% if type == 'users' %}
                        <strong>{{ item.name }}</strong>
                        <small>{{ item.email }} - {{ t('admin.posts_count', {'count': item.posts_count|default(0)}) }}</small>
                    {% elseif type == 'posts' %}
                        <strong>{{ item.title }}</strong>
                        <small>{{ item.author.name|default(t('admin.unknown_author')) }} - {{ t('admin.' ~ item.status|default('draft')) }} - {{ t('admin.comments_count', {'count': item.comments_count|default(0)}) }}</small>
                    {% else %}
                        <strong>{{ item.author.name|default(t('admin.unknown_author')) }}</strong>
                        <small>{{ item.post.title|default(t('admin.untitled_post')) }} - {{ item.content|length > 70 ? item.content|slice(0, 70) ~ '...' : item.content }}</small>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="admin-empty-state admin-empty-state-sm">
                <i class="bi bi-inbox"></i>
                <strong>{{ t('admin.no_activity') }}</strong>
            </div>
        {% endfor %}
    </div>
</article>
