{% extends 'admin/layout.twig' %}

{% set admin_section = 'comments' %}

{% block title %}{{ t('admin.view_comment') }}{% endblock %}
{% block breadcrumb %}{{ t('admin.view_comment') }}{% endblock %}
{% block page_title %}{{ t('admin.view_comment') }}{% endblock %}

{% block content %}
    <section class="admin-panel admin-detail-panel">
        <div class="admin-panel-header">
            <div>
                <h3>Comment #{{ comment.id }}</h3>
                <p>{{ comment.author.name|default(t('admin.unknown_author')) }} {{ t('admin.on') }} {{ comment.post.title|default(t('admin.untitled_post')) }}</p>
            </div>
            <div class="admin-row-actions">
                <a href="/admin/comments/{{ comment.id }}/edit" class="btn admin-btn-secondary"><i class="bi bi-pencil"></i> {{ t('admin.edit') }}</a>
                <form method="POST" action="/admin/comments/{{ comment.id }}/delete" onsubmit="return confirm('{{ t('admin.delete_comment_confirm') }}');">
                    {{ csrf_field() }}
                    <button class="btn admin-btn-primary admin-btn-danger" type="submit"><i class="bi bi-trash"></i> {{ t('admin.delete') }}</button>
                </form>
            </div>
        </div>
        <div class="admin-detail-body">
            <dl class="admin-detail-list">
                <div><dt>{{ t('admin.id') }}</dt><dd>#{{ comment.id }}</dd></div>
                <div><dt>{{ t('admin.author') }}</dt><dd>{{ comment.author.name|default(t('admin.unknown_author')) }}</dd></div>
                <div><dt>{{ t('admin.post') }}</dt><dd>{{ comment.post.title|default(t('admin.untitled_post')) }}</dd></div>
                <div><dt>{{ t('admin.created_at') }}</dt><dd>{{ comment.created_at|default(t('admin.recently')) }}</dd></div>
            </dl>
            <div class="admin-comment-box">{{ comment.content }}</div>
        </div>
    </section>
{% endblock %}
