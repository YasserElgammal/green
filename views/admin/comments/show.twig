{% extends 'admin/layout.twig' %}

{% set admin_section = 'comments' %}

{% block title %}View Comment{% endblock %}
{% block breadcrumb %}View Comment{% endblock %}
{% block page_title %}View Comment{% endblock %}

{% block content %}
    <section class="admin-panel admin-detail-panel">
        <div class="admin-panel-header">
            <div>
                <h3>Comment #{{ comment.id }}</h3>
                <p>{{ comment.author.name|default('Unknown author') }} on {{ comment.post.title|default('Untitled post') }}</p>
            </div>
            <div class="admin-row-actions">
                <a href="/admin/comments/{{ comment.id }}/edit" class="btn admin-btn-secondary"><i class="bi bi-pencil"></i> Edit</a>
                <form method="POST" action="/admin/comments/{{ comment.id }}/delete" onsubmit="return confirm('Delete this comment? This action cannot be undone.');">
                    {{ csrf_field() }}
                    <button class="btn admin-btn-primary admin-btn-danger" type="submit"><i class="bi bi-trash"></i> Delete</button>
                </form>
            </div>
        </div>
        <div class="admin-detail-body">
            <dl class="admin-detail-list">
                <div><dt>ID</dt><dd>#{{ comment.id }}</dd></div>
                <div><dt>Author</dt><dd>{{ comment.author.name|default('Unknown author') }}</dd></div>
                <div><dt>Post</dt><dd>{{ comment.post.title|default('Untitled post') }}</dd></div>
                <div><dt>Created At</dt><dd>{{ comment.created_at|default('Recently') }}</dd></div>
            </dl>
            <div class="admin-comment-box">{{ comment.content }}</div>
        </div>
    </section>
{% endblock %}
