{% extends 'admin/layout.twig' %}

{% set admin_section = 'comments' %}

{% block title %}{{ t('admin.comments') }}{% endblock %}
{% block breadcrumb %}{{ t('admin.comments') }}{% endblock %}
{% block page_title %}{{ t('admin.comment_management') }}{% endblock %}

{% block content %}
    <section class="admin-page-header">
        <div>
            <p class="admin-eyebrow">{{ t('admin.community_moderation') }}</p>
            <h2>{{ t('admin.comments_heading') }}</h2>
            <p>{{ t('admin.comments_intro') }}</p>
        </div>
    </section>

    <section class="admin-panel">
        <div class="admin-panel-header">
            <div><h3>{{ t('admin.list_comments') }}</h3><p>{{ t('admin.comments_list_help') }}</p></div>
            <form method="GET" action="/admin/comments" class="admin-table-search">
                <i class="bi bi-search"></i>
                <input type="search" name="search" value="{{ search }}" placeholder="{{ t('admin.search_comments') }}" aria-label="{{ t('admin.search_comments') }}">
                <button class="btn admin-btn-primary" type="submit">{{ t('admin.search') }}</button>
                {% if search %}
                    <a class="btn admin-btn-secondary admin-search-reset" href="/admin/comments"><i class="bi bi-x-lg"></i> {{ t('admin.clear') }}</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive admin-table-wrap">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr><th>{{ t('admin.id') }}</th><th>{{ t('admin.author') }}</th><th>{{ t('admin.post') }}</th><th>{{ t('admin.content_preview') }}</th><th>{{ t('admin.created_at') }}</th><th class="text-end">{{ t('admin.actions') }}</th></tr>
                </thead>
                <tbody>
                    {% for comment in comments %}
                        <tr>
                            <td class="fw-semibold">#{{ comment.id }}</td>
                            <td>{{ comment.author.name|default(t('admin.unknown_author')) }}</td>
                            <td>{{ comment.post.title|default(t('admin.untitled_post')) }}</td>
                            <td>{{ comment.content|length > 90 ? comment.content|slice(0, 90) ~ '...' : comment.content }}</td>
                            <td>{{ comment.created_at|default(t('admin.recently')) }}</td>
                            <td>
                                <div class="admin-row-actions">
                                    <a class="btn admin-action-btn" href="/admin/comments/{{ comment.id }}" aria-label="{{ t('admin.view_comment_action') }}"><i class="bi bi-eye"></i></a>
                                    <a class="btn admin-action-btn" href="/admin/comments/{{ comment.id }}/edit" aria-label="{{ t('admin.edit_comment_action') }}"><i class="bi bi-pencil"></i></a>
                                    <form method="POST" action="/admin/comments/{{ comment.id }}/delete" onsubmit="return confirm('{{ t('admin.delete_comment_confirm') }}');">
                                        {{ csrf_field() }}
                                        <button class="btn admin-action-btn admin-action-danger" type="submit" aria-label="{{ t('admin.delete_comment_action') }}"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6"><div class="admin-empty-state"><i class="bi bi-inbox"></i><strong>{{ t('admin.no_comments') }}</strong><span>{{ t('admin.no_comments_help') }}</span></div></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'admin/partials/pagination.twig' with {'base_path': '/admin/comments', 'meta': meta, 'query_suffix': '&search=' ~ search|url_encode} %}
    </section>
{% endblock %}
