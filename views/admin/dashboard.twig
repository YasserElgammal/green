{% extends 'admin/layout.twig' %}

{% set admin_section = 'dashboard' %}

{% block title %}{{ t('admin.admin_dashboard') }}{% endblock %}
{% block breadcrumb %}{{ t('admin.dashboard') }}{% endblock %}
{% block page_title %}{{ t('admin.admin_dashboard') }}{% endblock %}

{% block content %}
    <section class="admin-page-header">
        <div>
            <p class="admin-eyebrow">{{ t('admin.ecosystem') }}</p>
            <h2>{{ t('admin.dashboard_heading') }}</h2>
            <p>{{ t('admin.dashboard_intro') }}</p>
        </div>
        <div class="admin-header-actions">
            <a href="/admin/users/create" class="btn admin-btn-primary"><i class="bi bi-person-plus"></i> {{ t('admin.new_user') }}</a>
            <a href="/admin/posts/create" class="btn admin-btn-secondary"><i class="bi bi-pencil-square"></i> {{ t('admin.new_post') }}</a>
        </div>
    </section>

    {% include 'admin/partials/stats.twig' with {'stats': stats} %}

    <section class="admin-dashboard-lists">
        {% include 'admin/partials/activity-list.twig' with {'title': t('admin.latest_users'), 'items': latestUsers, 'type': 'users'} %}
        {% include 'admin/partials/activity-list.twig' with {'title': t('admin.latest_posts'), 'items': latestPosts, 'type': 'posts'} %}
        {% include 'admin/partials/activity-list.twig' with {'title': t('admin.latest_comments'), 'items': latestComments, 'type': 'comments'} %}
    </section>
{% endblock %}
