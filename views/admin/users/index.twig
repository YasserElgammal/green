{% extends 'admin/layout.twig' %}

{% set admin_section = 'users' %}

{% block title %}Users{% endblock %}
{% block breadcrumb %}Users{% endblock %}
{% block page_title %}User Management{% endblock %}

{% block content %}
    <section class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Identity and access</p>
            <h2>Manage users and administrator access.</h2>
            <p>Create accounts, update profile details, toggle admin rights, and prevent removal of the last admin account.</p>
        </div>
        <a href="/admin/users/create" class="btn admin-btn-primary"><i class="bi bi-person-plus"></i> Create user</a>
    </section>

    <section class="admin-panel">
        <div class="admin-panel-header">
            <div>
                <h3>List Users</h3>
                <p>ID, name, email, admin state, post count, created date, and actions.</p>
            </div>
            <form method="GET" action="/admin/users" class="admin-table-search">
                <i class="bi bi-search"></i>
                <input type="search" name="search" value="{{ search }}" placeholder="Search users" aria-label="Search users">
                <button class="btn admin-btn-primary" type="submit">Search</button>
                {% if search %}
                    <a class="btn admin-btn-secondary admin-search-reset" href="/admin/users"><i class="bi bi-x-lg"></i> Clear</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive admin-table-wrap">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        {% set columns = {'id': 'ID', 'name': 'Name', 'email': 'Email', 'is_admin': 'Is Admin', 'created_at': 'Created At'} %}
                        {% for key, label in columns %}
                            <th scope="col">
                                <a class="admin-sort-link" href="/admin/users?sort={{ key }}&direction={{ sort == key ? nextDirection : 'ASC' }}&search={{ search|url_encode }}">
                                    {{ label }} <i class="bi {{ sort == key ? (direction == 'ASC' ? 'bi-sort-up' : 'bi-sort-down') : 'bi-arrow-down-up' }}"></i>
                                </a>
                            </th>
                        {% endfor %}
                        <th scope="col">Posts</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="fw-semibold">#{{ user.id }}</td>
                            <td><div class="admin-table-user"><span class="admin-avatar admin-avatar-sm">{{ user.name|first|upper }}</span>{{ user.name }}</div></td>
                            <td>{{ user.email }}</td>
                            <td><span class="admin-badge {{ user.is_admin ? 'admin-badge-success' : 'admin-badge-muted' }}">{{ user.is_admin ? 'Yes' : 'No' }}</span></td>
                            <td>{{ user.created_at|default('Recently') }}</td>
                            <td>{{ user.posts_count|default(0) }}</td>
                            <td>
                                <div class="admin-row-actions">
                                    <a class="btn admin-action-btn" href="/admin/users/{{ user.id }}/edit" aria-label="Edit user"><i class="bi bi-pencil"></i></a>
                                    <form method="POST" action="/admin/users/{{ user.id }}/toggle-admin">
                                        {{ csrf_field() }}
                                        <button class="btn admin-action-btn" type="submit" aria-label="Toggle admin"><i class="bi bi-shield-check"></i></button>
                                    </form>
                                    <form method="POST" action="/admin/users/{{ user.id }}/delete" onsubmit="return confirm('Delete this user? This action cannot be undone.');">
                                        {{ csrf_field() }}
                                        <button class="btn admin-action-btn admin-action-danger" type="submit" aria-label="Delete user"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7"><div class="admin-empty-state"><i class="bi bi-inbox"></i><strong>No users found</strong><span>Create the first user or adjust your search.</span></div></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'admin/partials/pagination.twig' with {'base_path': '/admin/users', 'meta': meta, 'query_suffix': '&sort=' ~ sort ~ '&direction=' ~ direction ~ '&search=' ~ search|url_encode} %}
    </section>
{% endblock %}
