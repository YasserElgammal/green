{% extends 'admin/layout.twig' %}

{% set admin_section = 'users' %}

{% block title %}{{ t('admin.users') }}{% endblock %}
{% block breadcrumb %}{{ t('admin.users') }}{% endblock %}
{% block page_title %}User Management{% endblock %}

{% block content %}
    <section class="admin-page-header">
        <div>
            <p class="admin-eyebrow">{{ t('admin.identity_access') }}</p>
            <h2>{{ t('admin.users_heading') }}</h2>
            <p>{{ t('admin.users_intro') }}</p>
        </div>
        <a href="/admin/users/create" class="btn admin-btn-primary"><i class="bi bi-person-plus"></i> {{ t('admin.create_user') }}</a>
    </section>

    <section class="admin-panel">
        <div class="admin-panel-header">
            <div>
                <h3>{{ t('admin.list_users') }}</h3>
                <p>{{ t('admin.users_list_help') }}</p>
            </div>
            <form method="GET" action="/admin/users" class="admin-table-search">
                <i class="bi bi-search"></i>
                <input type="search" name="search" value="{{ search }}" placeholder="{{ t('admin.search_users') }}" aria-label="{{ t('admin.search_users') }}">
                <button class="btn admin-btn-primary" type="submit">{{ t('admin.search') }}</button>
                {% if search %}
                    <a class="btn admin-btn-secondary admin-search-reset" href="/admin/users"><i class="bi bi-x-lg"></i> {{ t('admin.clear') }}</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive admin-table-wrap">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        {% set columns = {'id': t('admin.id'), 'name': t('admin.name'), 'email': t('admin.email'), 'is_admin': t('admin.is_admin'), 'created_at': t('admin.created_at')} %}
                        {% for key, label in columns %}
                            <th scope="col">
                                <a class="admin-sort-link" href="/admin/users?sort={{ key }}&direction={{ sort == key ? nextDirection : 'ASC' }}&search={{ search|url_encode }}">
                                    {{ label }} <i class="bi {{ sort == key ? (direction == 'ASC' ? 'bi-sort-up' : 'bi-sort-down') : 'bi-arrow-down-up' }}"></i>
                                </a>
                            </th>
                        {% endfor %}
                        <th scope="col">{{ t('admin.posts') }}</th>
                        <th scope="col" class="text-end">{{ t('admin.actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="fw-semibold">#{{ user.id }}</td>
                            <td><div class="admin-table-user"><span class="admin-avatar admin-avatar-sm">{{ user.name|first|upper }}</span>{{ user.name }}</div></td>
                            <td>{{ user.email }}</td>
                            <td><span class="admin-badge {{ user.is_admin ? 'admin-badge-success' : 'admin-badge-muted' }}">{{ user.is_admin ? t('admin.yes') : t('admin.no') }}</span></td>
                            <td>{{ user.created_at|default(t('admin.recently')) }}</td>
                            <td>{{ user.posts_count|default(0) }}</td>
                            <td>
                                <div class="admin-row-actions">
                                    <a class="btn admin-action-btn" href="/admin/users/{{ user.id }}/edit" aria-label="{{ t('admin.edit_user_action') }}"><i class="bi bi-pencil"></i></a>
                                    <form method="POST" action="/admin/users/{{ user.id }}/toggle-admin">
                                        {{ csrf_field() }}
                                        <button class="btn admin-action-btn" type="submit" aria-label="{{ t('admin.toggle_admin') }}"><i class="bi bi-shield-check"></i></button>
                                    </form>
                                    <form method="POST" action="/admin/users/{{ user.id }}/delete" onsubmit="return confirm('{{ t('admin.delete_user_confirm') }}');">
                                        {{ csrf_field() }}
                                        <button class="btn admin-action-btn admin-action-danger" type="submit" aria-label="{{ t('admin.delete_user_action') }}"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7"><div class="admin-empty-state"><i class="bi bi-inbox"></i><strong>{{ t('admin.no_users') }}</strong><span>{{ t('admin.no_users_help') }}</span></div></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'admin/partials/pagination.twig' with {'base_path': '/admin/users', 'meta': meta, 'query_suffix': '&sort=' ~ sort ~ '&direction=' ~ direction ~ '&search=' ~ search|url_encode} %}
    </section>
{% endblock %}
