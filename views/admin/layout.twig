{% set app_locale = session().get('locale') ?? 'en' %}
{% set app_dir = app_locale == 'ar' ? 'rtl' : 'ltr' %}
{% set user_name = session().get('user_name') ?? 'Admin User' %}
<!DOCTYPE html>
<html lang="{{ app_locale }}" dir="{{ app_dir }}" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Admin Dashboard{% endblock %} | Green Framework</title>
    <script src="/assets/js/theme-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    {% if app_dir == 'rtl' %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    {% else %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% endif %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/assets/css/theme.css">
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
            <div class="admin-sidebar-header">
                <a href="/admin" class="admin-brand" id="adminSidebarLabel">
                    <span class="admin-brand-mark">G</span>
                    <span><strong>Green</strong><small>Framework</small></span>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
            </div>

            <nav class="admin-nav" aria-label="Admin navigation">
                <a href="/admin" class="admin-nav-link {{ admin_section|default('dashboard') == 'dashboard' ? 'active' }}"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a>
                <a href="/admin/users" class="admin-nav-link {{ admin_section|default('') == 'users' ? 'active' }}"><i class="bi bi-people"></i><span>Users</span></a>
                <a href="/admin/posts" class="admin-nav-link {{ admin_section|default('') == 'posts' ? 'active' }}"><i class="bi bi-file-earmark-text"></i><span>Posts</span></a>
                <a href="/admin/comments" class="admin-nav-link {{ admin_section|default('') == 'comments' ? 'active' }}"><i class="bi bi-chat-left-text"></i><span>Comments</span></a>
                <a href="/admin/statistics" class="admin-nav-link {{ admin_section|default('') == 'statistics' ? 'active' }}"><i class="bi bi-bar-chart-line"></i><span>Statistics</span></a>
            </nav>

            <div class="admin-sidebar-card">
                <span class="admin-status-dot"></span>
                <div><strong>Green Skeleton</strong><small>Default admin experience</small></div>
            </div>
        </aside>

        <div class="admin-content">
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="admin-icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open navigation">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb admin-breadcrumb mb-1">
                                <li class="breadcrumb-item"><a href="/">Green</a></li>
                                <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                                <li class="breadcrumb-item active" aria-current="page">{% block breadcrumb %}Dashboard{% endblock %}</li>
                            </ol>
                        </nav>
                        <h1 class="admin-page-title mb-0">{% block page_title %}Admin Dashboard{% endblock %}</h1>
                    </div>
                </div>

                <div class="admin-topbar-actions">
                    <a class="admin-icon-btn" href="/" aria-label="View site"><i class="bi bi-globe2"></i></a>
                    <div class="dropdown theme-toggle">
                        <button
                            class="admin-icon-btn dropdown-toggle"
                            type="button"
                            id="adminThemeToggle"
                            data-theme-toggle
                            data-theme-label-light="Light"
                            data-theme-label-dark="Dark"
                            data-theme-label-system="System"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Choose theme"
                        >
                            <i class="bi bi-circle-half theme-toggle-icon" data-theme-toggle-icon aria-hidden="true"></i>
                            <span class="visually-hidden" data-theme-toggle-label>System</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm p-2" aria-labelledby="adminThemeToggle">
                            <li><button class="dropdown-item" type="button" data-theme-choice="light"><i class="bi bi-sun"></i>Light</button></li>
                            <li><button class="dropdown-item" type="button" data-theme-choice="dark"><i class="bi bi-moon-stars"></i>Dark</button></li>
                            <li><button class="dropdown-item" type="button" data-theme-choice="system"><i class="bi bi-laptop"></i>System</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="admin-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="admin-avatar">{{ user_name|first|upper }}</span>
                            <span class="d-none d-sm-flex flex-column align-items-start">
                                <strong>{{ user_name }}</strong>
                                <small>Administrator</small>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow admin-user-menu">
                            <li><a class="dropdown-item" href="/profile"><i class="bi bi-person"></i>Profile</a></li>
                            <li><a class="dropdown-item" href="/admin"><i class="bi bi-sliders"></i>Dashboard</a></li>
                            <li><hr class="dropdown-divider"></li>
                            {% if session().has('user_id') %}
                                <li>
                                    <form action="/logout" method="POST">
                                        {{ csrf_field() }}
                                        <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right"></i>Logout</button>
                                    </form>
                                </li>
                            {% else %}
                                <li><a class="dropdown-item" href="/login"><i class="bi bi-box-arrow-in-right"></i>Login</a></li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </header>

            <main class="admin-main">
                {% set success = session().getFlash('success') %}
                {% if success %}
                    <div class="admin-toast admin-toast-success" role="alert"><i class="bi bi-check-circle-fill"></i>{{ success[0] }}</div>
                {% endif %}
                {% set error = session().getFlash('error') %}
                {% if error %}
                    <div class="admin-toast admin-toast-danger" role="alert"><i class="bi bi-exclamation-triangle-fill"></i>{{ error[0] }}</div>
                {% endif %}

                {% block content %}{% endblock %}
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/theme-toggle.js"></script>
    <script src="/assets/js/flash-messages.js"></script>
</body>
</html>
