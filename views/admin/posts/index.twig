{% extends 'admin/layout.twig' %}

{% set admin_section = 'posts' %}

{% block title %}{{ t('admin.posts') }}{% endblock %}
{% block breadcrumb %}{{ t('admin.posts') }}{% endblock %}
{% block page_title %}{{ t('admin.post_management') }}{% endblock %}

{% block content %}
    <section class="admin-page-header">
        <div>
            <p class="admin-eyebrow">{{ t('admin.content_operations') }}</p>
            <h2>{{ t('admin.posts_heading') }}</h2>
            <p>{{ t('admin.posts_intro') }}</p>
        </div>
        <a href="/admin/posts/create" class="btn admin-btn-primary"><i class="bi bi-pencil-square"></i> {{ t('admin.create_post_action') }}</a>
    </section>

    <section class="admin-panel">
        <div class="admin-panel-header">
            <div><h3>{{ t('admin.list_posts') }}</h3><p>{{ t('admin.posts_list_help') }}</p></div>
            <form method="GET" action="/admin/posts" class="admin-table-search">
                <i class="bi bi-search"></i>
                <input type="search" name="search" value="{{ search }}" placeholder="{{ t('admin.search_posts') }}" aria-label="{{ t('admin.search_posts') }}">
                <select name="status" class="admin-inline-select" aria-label="{{ t('admin.filter_status') }}">
                    <option value="">{{ t('admin.all_statuses') }}</option>
                    {% for option in statuses %}
                        <option value="{{ option.value }}" {{ status == option.value ? 'selected' }}>{{ t('admin.' ~ option.value) }}</option>
                    {% endfor %}
                </select>
                <button class="btn admin-btn-primary" type="submit">{{ t('admin.search') }}</button>
                {% if search or status %}
                    <a class="btn admin-btn-secondary admin-search-reset" href="/admin/posts"><i class="bi bi-x-lg"></i> {{ t('admin.clear') }}</a>
                {% endif %}
            </form>
        </div>

        <div class="table-responsive admin-table-wrap">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr><th>{{ t('admin.id') }}</th><th>{{ t('admin.title') }}</th><th>{{ t('admin.author') }}</th><th>{{ t('admin.status') }}</th><th>{{ t('admin.comments') }}</th><th>{{ t('admin.created_at') }}</th><th class="text-end">{{ t('admin.actions') }}</th></tr>
                </thead>
                <tbody>
                    {% for post in posts %}
                        <tr>
                            <td class="fw-semibold">#{{ post.id }}</td>
                            <td>{{ post.title }}</td>
                            <td>{{ post.author.name|default(t('admin.unknown_author')) }}</td>
                            <td><span class="admin-badge admin-badge-info">{{ t('admin.' ~ post.status|default('draft')) }}</span></td>
                            <td>{{ post.comments_count|default(0) }}</td>
                            <td>{{ post.created_at|default(t('admin.recently')) }}</td>
                            <td>
                                <div class="admin-row-actions">
                                    <a class="btn admin-action-btn" href="/admin/posts/{{ post.id }}/edit" aria-label="{{ t('admin.edit_post_action') }}"><i class="bi bi-pencil"></i></a>
                                    <form method="POST" action="/admin/posts/{{ post.id }}/delete" onsubmit="return confirm('{{ t('admin.delete_post_confirm') }}');">
                                        {{ csrf_field() }}
                                        <button class="btn admin-action-btn admin-action-danger" type="submit" aria-label="{{ t('admin.delete_post_action') }}"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7"><div class="admin-empty-state"><i class="bi bi-inbox"></i><strong>{{ t('admin.no_posts') }}</strong><span>{{ t('admin.no_posts_help') }}</span></div></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'admin/partials/pagination.twig' with {'base_path': '/admin/posts', 'meta': meta, 'query_suffix': '&search=' ~ search|url_encode ~ '&status=' ~ status|url_encode} %}
    </section>
{% endblock %}
