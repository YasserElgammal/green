{% extends 'layout.twig' %}

{% block title %}{{ t('auth.register.title') }}{% endblock %}

{% block content %}
<div class="row justify-content-center my-4">
    <div class="col-md-5">
        <div class="glass-card p-5 border-0 shadow-lg position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 w-100" style="height: 5px; background: linear-gradient(90deg, var(--green-primary), var(--green-dark));"></div>

            <div class="auth-icon-container">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <div class="text-center mb-4">
                <h2 class="fw-bold mb-1" style="background: linear-gradient(135deg, var(--green-dark) 0%, var(--green-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    {{ t('auth.register.heading') }}
                </h2>
                <p class="text-muted small">{{ t('auth.register.subheading') }}</p>
            </div>

            {% set error = session().getFlash('error') %}
            {% if error %}
                <div class="alert alert-danger shadow-sm border-0 rounded-4 mb-4" role="alert">
                    {{ error }}
                </div>
            {% endif %}

            {% set formErrors = session().getFlash('errors') %}
            <form action="{{ route('register.store') }}" method="POST">
                {{ csrf_field() }}

                <div class="mb-3">
                    <label for="name" class="form-label-custom">{{ t('auth.register.name') }}</label>
                    <input type="text" class="form-control form-control-custom {% if formErrors.name %}is-invalid{% endif %}" id="name" name="name" minlength="2" maxlength="100" required>
                    {% if formErrors.name %}
                        <div class="invalid-feedback">{{ formErrors.name[0] }}</div>
                    {% endif %}
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label-custom">{{ t('auth.register.email') }}</label>
                    <input type="email" class="form-control form-control-custom {% if formErrors.email %}is-invalid{% endif %}" id="email" name="email" maxlength="255" required>
                    {% if formErrors.email %}
                        <div class="invalid-feedback">{{ formErrors.email[0] }}</div>
                    {% endif %}
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label-custom">{{ t('auth.register.password') }}</label>
                    <input type="password" class="form-control form-control-custom {% if formErrors.password %}is-invalid{% endif %}" id="password" name="password" minlength="8" required>
                    {% if formErrors.password %}
                        <div class="invalid-feedback">{{ formErrors.password[0] }}</div>
                    {% endif %}
                </div>

                <button type="submit" class="btn btn-green rounded-pill w-100 py-2 fw-bold shadow-sm">
                    {{ t('auth.register.submit') }}
                </button>
            </form>

            <div class="mt-4 text-center">
                <small class="text-muted">
                    {{ t('auth.register.already_have_account') }}
                    <a href="{{ route('login.form') }}" class="text-success fw-semibold text-decoration-none">
                        {{ t('auth.register.login_here') }}
                    </a>
                </small>
            </div>
        </div>
    </div>
</div>
{% endblock %}
