{% extends 'layout.twig' %}

{% block title %}{{ t('auth.login.title') }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4 text-center">{{ t('auth.login.heading') }}</h2>

        {% set error = session().getFlash('error') %}
        {% if error %}
            <div class="alert alert-danger">{{ error[0] }}</div>
        {% endif %}

        <form action="/login" method="POST">
            {{ csrf_field() }}
            <div class="mb-3">
                <label for="email" class="form-label">{{ t('auth.login.email') }}</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">{{ t('auth.login.password') }}</label>
                <input type="password" class="form-control" id="password" name="password" required>
            </div>
            <button type="submit" class="btn btn-success w-100">{{ t('auth.login.submit') }}</button>
        </form>
    </div>
</div>
{% endblock %}
