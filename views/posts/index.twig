{% extends 'layout.twig' %}

{% block title %}{{ t('posts.index.title') }}
{% endblock %}

{% block content %}
	<div class="row mb-4">
		<div class="col-md-8 mx-auto">
			<h2 class="mb-3">{{ t('posts.index.heading') }}</h2>

			{% if session().has('user_id') %}
				<div class="card mb-4 border-success">
					<div class="card-body">
						<h5 class="card-title text-success">{{ t('posts.index.create_post') }}</h5>
						<form action="/posts" method="POST">
						{{ csrf_field() }}
							<div class="mb-3">
								<input type="text" name="title" class="form-control" placeholder="{{ t('posts.index.post_title') }}" required>
							</div>
							<div class="mb-3">
								<textarea name="body" rows="3" class="form-control" placeholder="{{ t('posts.index.post_body') }}" required></textarea>
							</div>
							<button type="submit" class="btn btn-success">{{ t('posts.index.publish') }}</button>
						</form>
					</div>
				</div>
			{% else %}
				<div class="alert alert-info py-2">
					<a href="/login" class="alert-link text-decoration-none">{{ t('posts.index.log_in') }}</a>
					{{ t('posts.index.login_to_join') }}
				</div>
			{% endif %}

			{% for post in posts %}
				<div class="card mb-3">
					<div class="card-body">
						<h4 class="card-title mb-2">
							<a href="/posts/{{ post.id }}" class="text-dark text-decoration-none">
								{{ post.title }}
							</a>
						</h4>

						<p class="card-text text-muted mb-2">
							<small>{{ t('posts.index.by_author', {'author': post.author.name|default(t('posts.index.unknown'))}) }}</small>
						</p>

						<p class="card-text">
							{{ post.body|length > 100 ? post.body|slice(0, 100) ~ '...' : post.body }}
						</p>

						<div class="d-flex justify-content-between align-items-center mt-3">
							<a href="/posts/{{ post.id }}" class="btn btn-sm btn-outline-success">
								{{ t('posts.index.read_more') }}
							</a>
						</div>
					</div>
				</div>
			{% else %}
				<p class="text-muted">{{ t('posts.index.no_posts') }}</p>
			{% endfor %}

			{% if meta.total_pages > 1 %}
				<nav aria-label="Posts pagination">
					<ul
						class="pagination justify-content-center">

						{# Previous #}
						<li class="page-item {{ not meta.has_prev ? 'disabled' }}">
							{% if not meta.has_prev %}
								<span class="page-link">«</span>
							{% else %}
								<a class="page-link" href="?page={{ meta.current_page - 1 }}&order={{ order }}">«</a>
							{% endif %}
						</li>

						{# Page numbers #}
						{% for p in 1..meta.total_pages %}
							<li class="page-item {{ p == meta.current_page ? 'active' }}">
								{% if p == meta.current_page %}
									<span class="page-link">{{ p }}</span>
								{% else %}
									<a class="page-link" href="?page={{ p }}&order={{ order }}">{{ p }}</a>
								{% endif %}
							</li>
						{% endfor %}

						{# Next #}
						<li class="page-item {{ not meta.has_next ? 'disabled' }}">
							{% if not meta.has_next %}
								<span class="page-link">»</span>
							{% else %}
								<a class="page-link" href="?page={{ meta.current_page + 1 }}&order={{ order }}">»</a>
							{% endif %}
						</li>

					</ul>
				</nav>

				<p class="text-center text-muted small">
					{{ t('posts.index.page_info', {'current': meta.current_page, 'total': meta.total_pages, 'items': meta.total_items})|raw }}
				</p>
			{% endif %}
		</div>
	</div>
{% endblock %}
